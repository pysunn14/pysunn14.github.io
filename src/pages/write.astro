---
import Layout from "@/layouts/Layout.astro";
import BlogEditor from "@/components/BlogEditor";

const isLocal = import.meta.env.DEV && ["localhost", "127.0.0.1", "[::1]"].includes(Astro.url.hostname);
Astro.response.status = isLocal ? 200 : 404;
Astro.response.headers.set("Cache-Control", "no-store");
---

<Layout title="Write" description="로컬 블로그 글쓰기" wide>
  {isLocal ? <BlogEditor client:only="react" /> : <p>이 페이지는 로컬 개발 서버에서만 열립니다.</p>}
</Layout>
