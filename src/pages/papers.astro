---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import BlurFade from "@/components/magicui/blur-fade";

const papers = [
  {
    topic: "Speculative Decoding",
    venue: "ICML 2026",
    title: "DFlash: Block Diffusion for Flash Speculative Decoding",
    authors: "Jian Chen, Yesheng Liang, Zhijian Liu",
    paperUrl: "https://arxiv.org/abs/2602.06036",
    codeUrl: "https://github.com/z-lab/dflash",
  },
  {
    topic: "Attention Kernels",
    venue: "MLSys 2025",
    title: "FlashInfer: Efficient and Customizable Attention Engine for LLM Inference Serving",
    authors: "Zihao Ye et al.",
    paperUrl: "https://proceedings.mlsys.org/paper_files/paper/2025/hash/dbf02b21d77409a2db30e56866a8ab3a-Abstract-Conference.html",
    codeUrl: "https://github.com/flashinfer-ai/flashinfer",
  },
];
---

<Layout title="Papers" description="관심있게 읽는 논문 저장용입니다.">
  <main class="flex flex-col gap-10">
    <BlurFade client:load delay={0.04}>
      <header>
        <h1 class="text-2xl font-bold tracking-tight">Papers</h1>
        <p class="mt-3 text-sm text-muted-foreground">관심있게 읽는 논문 저장용입니다.</p>
      </header>
    </BlurFade>
    {papers.map((paper, index) => (
    <BlurFade client:load delay={0.08 + index * 0.04}>
      <article class="border-y border-border py-6">
        <div class="mb-4 flex flex-wrap items-center justify-between gap-2 text-xs text-muted-foreground">
          <span>{paper.topic}</span>
          <span>{paper.venue}</span>
        </div>
        <h2 class="text-xl font-semibold leading-snug [overflow-wrap:anywhere]">
          <a
            href={paper.paperUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors hover:text-sky-700 dark:hover:text-sky-400 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-600 dark:focus-visible:outline-sky-400 active:text-muted-foreground"
          >{paper.title}</a>
        </h2>
        <p class="mt-3 text-sm text-muted-foreground">{paper.authors}</p>
        <div class="mt-4 flex items-center gap-6 text-sm">
          <a class="inline-flex min-h-11 items-center underline underline-offset-4 hover:text-sky-700 dark:hover:text-sky-400 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-600 dark:focus-visible:outline-sky-400 active:text-muted-foreground" href={paper.paperUrl} target="_blank" rel="noopener noreferrer">Paper ↗</a>
          <a class="inline-flex min-h-11 items-center underline underline-offset-4 hover:text-sky-700 dark:hover:text-sky-400 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-600 dark:focus-visible:outline-sky-400 active:text-muted-foreground" href={paper.codeUrl} target="_blank" rel="noopener noreferrer">Code ↗</a>
        </div>
      </article>
    </BlurFade>
    ))}
  </main>
</Layout>
