---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import BlurFade from "@/components/magicui/blur-fade";
---

<Layout title="Papers" description="관심있게 읽는 논문 저장용입니다.">
  <main class="flex flex-col gap-10">
    <BlurFade client:load delay={0.04}>
      <header>
        <h1 class="text-2xl font-bold tracking-tight">Papers</h1>
        <p class="mt-3 text-sm text-muted-foreground">관심있게 읽는 논문 저장용입니다.</p>
      </header>
    </BlurFade>
    <BlurFade client:load delay={0.08}>
      <article class="border-y border-border py-6">
        <div class="mb-4 flex flex-wrap items-center justify-between gap-2 text-xs text-muted-foreground">
          <span>Speculative Decoding</span>
          <span>ICML 2026</span>
        </div>
        <h2 class="text-xl font-semibold leading-snug [overflow-wrap:anywhere]">
          <a
            href="https://arxiv.org/abs/2602.06036"
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors hover:text-sky-700 dark:hover:text-sky-400 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-600 dark:focus-visible:outline-sky-400 active:text-muted-foreground"
          >DFlash: Block Diffusion for Flash Speculative Decoding</a>
        </h2>
        <p class="mt-3 text-sm text-muted-foreground">Jian Chen, Yesheng Liang, Zhijian Liu</p>
        <div class="mt-4 flex items-center gap-6 text-sm">
          <a class="inline-flex min-h-11 items-center underline underline-offset-4 hover:text-sky-700 dark:hover:text-sky-400 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-600 dark:focus-visible:outline-sky-400 active:text-muted-foreground" href="https://arxiv.org/abs/2602.06036" target="_blank" rel="noopener noreferrer">Paper ↗</a>
          <a class="inline-flex min-h-11 items-center underline underline-offset-4 hover:text-sky-700 dark:hover:text-sky-400 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-600 dark:focus-visible:outline-sky-400 active:text-muted-foreground" href="https://github.com/z-lab/dflash" target="_blank" rel="noopener noreferrer">Code ↗</a>
        </div>
      </article>
    </BlurFade>
  </main>
</Layout>
