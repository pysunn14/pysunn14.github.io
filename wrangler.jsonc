{
	"compatibility_date": "2026-04-30",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "pysunn-portfolio",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"workers_dev": false
}
