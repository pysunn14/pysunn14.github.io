{
	"compatibility_date": "2026-04-30",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "pysunn-portfolio",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "VISITOR_DB",
			"database_name": "pysunn-visitors",
			"database_id": "89af4b51-2231-49f0-a27f-cede4a4ad354"
		}
	],
	"observability": {
		"enabled": true
	},
	"workers_dev": false
}
